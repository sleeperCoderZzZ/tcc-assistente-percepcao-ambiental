# Configuração do Servidor Middleware
PORT=3000
NODE_ENV=development

# Configuração do Provedor de IA (Factory Pattern)
# Opções suportadas: 'mock', 'gemini', 'openai' ou 'multi-agent'
AI_PROVIDER=gemini

# Chaves de API (necessárias quando AI_PROVIDER=gemini ou AI_PROVIDER=openai)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Limites de Memória e Retenção
MAX_FILE_SIZE_MB=10
MEMORY_BUFFER_TIMEOUT_MS=5000

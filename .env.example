# Configuração do Servidor Middleware
PORT=3000
NODE_ENV=development

# Configuração do Provedor de IA (Factory Pattern)
# Opções suportadas: 'mock' (para testes/desenvolvimento local) ou 'gemini'
AI_PROVIDER=mock

# Chaves de API (necessárias quando AI_PROVIDER=gemini)
GEMINI_API_KEY=sua_chave_api_aqui

# Limites de Memória e Retenção
MAX_FILE_SIZE_MB=10
MEMORY_BUFFER_TIMEOUT_MS=5000
